# Copy this file to `.env` and fill in your real values.
# `.env` is gitignored; `.env.example` is committed as a template.

# Google AI Studio API key.
# Create one (free tier is plenty for this project) at:
#   https://aistudio.google.com/apikey
GOOGLE_API_KEY=your-google-api-key-here

# Optional overrides. Defaults live in src/config.py; uncomment to change.
# CHROMA_PATH=./chroma_db
# CHROMA_COLLECTION=health_insurance
# EMBEDDING_MODEL=text-embedding-004
# CHAT_MODEL=gemini-2.5-flash
# CHUNK_SIZE=500
# CHUNK_OVERLAP=50
# TOP_K=4
# SIMILARITY_THRESHOLD=0.6
# RAG_API_URL=http://localhost:8000/chat
# WEBHOOK_PORT=8001
