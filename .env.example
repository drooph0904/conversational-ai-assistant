# Copy this file to `.env` and fill in your real values.
# `.env` is gitignored; `.env.example` is committed as a template.

# OpenAI API key.
# Create one at: https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key-here

# Optional overrides. Defaults live in src/config.py; uncomment to change.
# CHROMA_PATH=./chroma_db
# CHROMA_COLLECTION=health_insurance
# EMBEDDING_MODEL=text-embedding-3-small
# CHAT_MODEL=gpt-4o-mini
# CHUNK_SIZE=500
# CHUNK_OVERLAP=50
# TOP_K=3
# SIMILARITY_THRESHOLD=0.6
# RAG_API_URL=http://localhost:8000/chat
# WEBHOOK_PORT=8001
